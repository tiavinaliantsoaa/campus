APP_NAME="ESCM Campus"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.escm.mg/campus
ASSET_URL=https://www.escm.mg/campus

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# SQLite pour la préproduction. Le fichier est database/database.sqlite.
DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL

# MySQL — remplacer le bloc SQLite par celui-ci le moment venu.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=escm_campus
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/campus
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="direction@escm.mg"
MAIL_FROM_NAME="${APP_NAME}"

CAMPUS_NAME="ESCM Business School"
CAMPUS_SHORT_NAME=ESCM
CAMPUS_CITY=Antananarivo
CAMPUS_COUNTRY=Madagascar
CAMPUS_ADMIN_EMAIL=direction@escm.mg
CAMPUS_ADMIN_NAME="Administration ESCM"
CAMPUS_ADMIN_PASSWORD=

# true charge les données de démonstration. Passer à false avant toute donnée réelle.
SEED_DEMO=true

VITE_APP_NAME="${APP_NAME}"
